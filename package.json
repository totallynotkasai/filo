{
  "name": "filo",
  "version": "0.1.0",
  "description": "A Personal Knowledge Management desktop application with infinite canvas mind mapping",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs --preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage --disableConsoleIntercept",
    "test:unit:strict": "node scripts/test-unit-strict.mjs",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "format": "prettier --write src/",
    "lint": "eslint . --max-warnings 0",
    "ci:gates": "node scripts/gates/run.mjs",
    "ci:test-typecheck": "node scripts/gates/run.mjs --only test-typecheck",
    "scratch-vault": "vitest run --config vitest.scratch-vault.config.mts",
    "ci:verify": "npm run lint && npm run check && npm run typecheck:main && npm run test:unit:strict && npm run build && npm run ci:gates",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run icons && npm run build && electron-builder --publish never",
    "package:win": "npm run icons && npm run build && electron-builder --win --publish never",
    "package:mac": "npm run icons && npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run icons && npm run build && electron-builder --linux --publish never",
    "package:dir": "npm run icons && npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-blockquote": "^3.31.3",
    "@tiptap/extension-bullet-list": "^3.31.3",
    "@tiptap/extension-code-block-lowlight": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-font-family": "^3.31.3",
    "@tiptap/extension-hard-break": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-ordered-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-task-item": "^3.31.3",
    "@tiptap/extension-task-list": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "dompurify": "^3.4.15",
    "focus-trap": "^8.2.2",
    "lowlight": "^3.2.0",
    "markdown-it": "^14.3.2",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.16",
    "rbush": "^4.0.1",
    "svelte-dnd-action": "^0.9.69",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/rbush": "^4.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "fast-check": "^4.10.2",
    "globals": "^17.6.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.filo.app",
    "productName": "Filo",
    "copyright": "Copyright © 2026 Filo",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filo"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Filo ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "Filo <noreply@filo.app>",
      "synopsis": "Local-first visual PKM",
      "description": "Filo is a local-first, visual-first Personal Knowledge Management desktop application combining mind maps, kanban, task lists, and documents in a single tool."
    }
  }
}
