{
  "name": "filo",
  "version": "0.2.0",
  "description": "A Personal Knowledge Management desktop application with infinite canvas mind mapping",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "node scripts/dev.mjs --preview",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage --disableConsoleIntercept",
    "test:unit:strict": "node scripts/test-unit-strict.mjs",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "format": "prettier --write src/",
    "lint": "eslint . --max-warnings 0",
    "knip": "knip",
    "ci:gates": "node scripts/gates/run.mjs",
    "ci:test-typecheck": "node scripts/gates/run.mjs --only test-typecheck",
    "scratch-vault": "vitest run --config vitest.scratch-vault.config.mts",
    "corpus:list": "node scripts/corpus/buildList.mjs",
    "corpus:run": "vitest run --config vitest.corpus.config.mts",
    "corpus:compare": "node scripts/corpus/compare.mjs",
    "ci:verify": "npm run lint && npm run knip && npm run check && npm run typecheck:main && npm run test:unit:strict && npm run build && npm run ci:gates",
    "icons": "node scripts/generate-icons.mjs",
    "package": "npm run icons && npm run build && electron-builder --publish never",
    "package:win": "npm run icons && npm run build && electron-builder --win --publish never",
    "package:mac": "npm run icons && npm run build && electron-builder --mac --publish never",
    "package:linux": "npm run icons && npm run build && electron-builder --linux --publish never",
    "package:dir": "npm run icons && npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-blockquote": "^3.31.4",
    "@tiptap/extension-code-block-lowlight": "^3.31.4",
    "@tiptap/extension-hard-break": "^3.31.4",
    "@tiptap/extension-heading": "^3.31.4",
    "@tiptap/extension-highlight": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-list": "^3.31.4",
    "@tiptap/extension-paragraph": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/extensions": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "dompurify": "^3.4.16",
    "focus-trap": "^8.2.2",
    "lowlight": "^3.2.0",
    "markdown-it": "^14.3.2",
    "minisearch": "^7.2.0",
    "nanoid": "^5.1.16",
    "prosemirror-markdown": "^1.13.8",
    "rbush": "^4.0.1",
    "svelte-dnd-action": "^0.9.69",
    "tiptap-markdown": "^0.9.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/rbush": "^4.0.0",
    "@vitest/browser-playwright": "^5.0.3",
    "@vitest/coverage-v8": "^5.0.3",
    "axe-core": "^4.13.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^30.1.2",
    "knip": "^6.39.0",
    "micromark": "^4.0.3",
    "micromark-extension-gfm-strikethrough": "^2.1.0",
    "micromark-extension-gfm-table": "^2.1.2",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.1",
    "png2icons": "^2.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.6.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "build": {
    "appId": "com.filo.app",
    "productName": "Filo",
    "copyright": "Copyright © 2026 Filo",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filo"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Filo ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "Office",
      "maintainer": "Filo <noreply@filo.app>",
      "synopsis": "Local-first visual PKM",
      "description": "Filo is a local-first, visual-first Personal Knowledge Management desktop application combining mind maps, kanban, task lists, and documents in a single tool."
    }
  }
}
