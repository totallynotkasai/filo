{
  "id": "dark-mode",
  "name": "Dark Mode",
  "base": "dark",
  "variables": {
    "--ui-bg": "#2b2b3d",
    "--ui-bg-secondary": "#262640",
    "--ui-surface": "#323250",
    "--ui-surface-hover": "#3c3c5a",
    "--ui-surface-active": "#45456a",
    "--ui-surface-raised": "#383860",

    "--ui-border": "#4a4a6c",
