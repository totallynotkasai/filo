{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "types": ["svelte", "vitest/globals", "node"]
  },
  "include": [
    "src/tests/unit/**/*.ts",
    "src/tests/component/**/*.ts",
    "src/tests/characterisation/**/*.ts",
    "src/tests/corpus/**/*.ts",
    "src/tests/helpers/**/*.ts",
    "src/tests/e2e/**/*.ts",
    "src/tests/setup.ts",
    "src/tests/types/**/*.d.ts",
    "src/renderer/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist", "release"]
}
